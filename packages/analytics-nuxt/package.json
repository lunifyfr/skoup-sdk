{
  "name": "@skoup/analytics-nuxt",
  "version": "0.2.0",
  "description": "Skoup Analytics for Nuxt 3 — a module: page views on navigation, useSkoup() everywhere.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lunifyfr/skoup-sdk.git",
    "directory": "packages/analytics-nuxt"
  },
  "homepage": "https://docs.skoup.ai/en/guides/tracking",
  "keywords": [
    "skoup",
    "analytics",
    "ai",
    "attribution",
    "nuxt"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./runtime/plugin": "./dist/runtime/plugin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/runtime/plugin.ts --format esm,cjs --dts --sourcemap --clean --target es2020 --external @nuxt/kit,vue,vue-router,#app,#imports,@skoup/analytics-vue",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@skoup/analytics": "^0.2.0",
    "@skoup/analytics-vue": "^0.2.0",
    "@nuxt/kit": "^3.18.1"
  },
  "peerDependencies": {
    "nuxt": ">=3.10"
  },
  "devDependencies": {
    "@nuxt/kit": "^3.18.1",
    "@nuxt/schema": "^3.18.1",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1",
    "vitest": "^3.2.4",
    "jsdom": "^26.1.0"
  }
}
