{
  "name": "@skoup/analytics-next",
  "version": "1.1.1",
  "description": "Skoup Analytics for Next.js (App Router) — one client component, page views on navigation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lunifyfr/skoup-sdk.git",
    "directory": "packages/analytics-next"
  },
  "homepage": "https://docs.skoup.ai/en/guides/tracking",
  "keywords": [
    "skoup",
    "analytics",
    "ai",
    "attribution",
    "next"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./proxy": {
      "types": "./dist/proxy.d.ts",
      "import": "./dist/proxy.js",
      "require": "./dist/proxy.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.tsx src/proxy.ts --format esm,cjs --dts --sourcemap --clean --target es2020 --external react,next,next/navigation,next/server,@skoup/analytics,@skoup/analytics-react",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@skoup/analytics": "^1.1.1",
    "@skoup/analytics-react": "^1.1.1"
  },
  "peerDependencies": {
    "next": ">=14",
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.1.9",
    "next": "^15.5.2",
    "react": "^19.1.1",
    "vitest": "^3.2.4",
    "jsdom": "^26.1.0",
    "@testing-library/react": "^16.3.0",
    "react-dom": "^19.1.1"
  }
}
