{
  "name": "@skoup/analytics",
  "version": "0.3.0",
  "description": "Skoup Analytics — measures the visits AI assistants (ChatGPT, Perplexity, Gemini, Claude…) send to your site, and the conversions they bring.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lunifyfr/skoup-sdk.git",
    "directory": "packages/analytics"
  },
  "homepage": "https://docs.skoup.ai/fr/guides/tracking",
  "keywords": [
    "skoup",
    "analytics",
    "ai",
    "chatgpt",
    "perplexity",
    "attribution",
    "geo"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./iife": "./dist/skoup.iife.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "vitest": "^3.2.4"
  }
}
